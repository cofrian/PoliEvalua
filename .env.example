NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_ACCESS_CODE=REPLACE_WITH_PRIVATE_ADMIN_CODE
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY
# Opcional: cadenas de modelos por tarea (separados por comas, el primero manda).
# Sin definir se usan los de src/lib/ai/models.ts. NVIDIA_MODEL, si existe, va delante.
# NVIDIA_MODELS_BUILDER=deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash
# NVIDIA_MODELS_ANALYSIS=z-ai/glm-5.3,moonshotai/kimi-k2.6
# Minutos de espera al transcriptor de respaldo antes de marcar el fallo.
# TRANSCRIPTION_EXTERNAL_WAIT_MINUTES=60
# Cola de procesamiento de exposiciones (ver docs/AI_ARCHITECTURE.md).
# Secreto del pulso que pg_cron envía a /api/jobs/tick (también en Supabase Vault).
JOBS_CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Cupo compartido de NVIDIA (peticiones/min) y trabajos internos simultáneos.
NVIDIA_REQUESTS_PER_MINUTE=30
MAX_INTERNAL_CONCURRENCY=4
# Transcripción: Whisper en Groq (gratis, console.groq.com). Sin clave, todo va al respaldo.
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
# GROQ_REQUESTS_PER_MINUTE=18
# Token de GitHub (fine-grained, permiso Actions: write en este repo) para que la
# app arranque al instante el transcriptor de Kaggle. Sin él, arranca en ≤10 min.
GITHUB_DISPATCH_TOKEN=
# Respaldo: trabajadores Whisper propios (ver worker/README.md).
# Token largo y aleatorio compartido con los trabajadores: openssl rand -hex 32
TRANSCRIPTION_WORKER_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# URLs de los trabajadores separadas por comas, para despertarlos al encolar.
TRANSCRIPTION_WORKER_URLS=https://USUARIO-transcriptor-1.hf.space
TRANSCRIPTION_LANGUAGE=es
# Opcionales: token de lectura de HF si los Spaces son privados, y reserva por trabajo.
HF_TOKEN=
TRANSCRIPTION_LEASE_SECONDS=900
