NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_ACCESS_CODE=REPLACE_WITH_PRIVATE_ADMIN_CODE
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY
NVIDIA_MODEL=REPLACE_WITH_NVIDIA_NIM_MODEL_ID
# Transcripción con trabajadores propios (ver worker/README.md).
# Token largo y aleatorio compartido con los trabajadores: openssl rand -hex 32
TRANSCRIPTION_WORKER_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# URLs de los trabajadores separadas por comas, para despertarlos al encolar.
TRANSCRIPTION_WORKER_URLS=https://USUARIO-transcriptor-1.hf.space
TRANSCRIPTION_LANGUAGE=es
# Opcionales: token de lectura de HF si los Spaces son privados, y reserva por trabajo.
HF_TOKEN=
TRANSCRIPTION_LEASE_SECONDS=2700
