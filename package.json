{
  "name": "polievalua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:rls": "node scripts/test-rls.mjs",
    "test:tenants": "node scripts/test-tenant-isolation.mjs",
    "test:features": "node scripts/test-platform-features.mjs",
    "test:students": "node scripts/test-student-privacy.mjs",
    "test:security": "npm run test:rls && npm run test:tenants && npm run test:features && npm run test:students",
    "test:prompts": "node scripts/check-prompt-version.mjs",
    "test:messages": "node scripts/check-messages.mjs",
    "smoke:assistant": "node scripts/smoke-assistant.mjs",
    "test:ci": "npm run test:prompts && npm run test:messages && npm run lint && npm run typecheck && npm run build",
    "test:models": "node scripts/check-nvidia-models.mjs",
    "smoke:audio": "node scripts/smoke-audio.mjs",
    "lock:fix": "node scripts/fix-lock-optional-deps.mjs",
    "bench:models": "node scripts/benchmark-nvidia-models.mjs",
    "test:all": "npm run test:ci && npm run test:security && npm run test:e2e",
    "showcase": "playwright test e2e/showcase.spec.ts --workers=1"
  },
  "dependencies": {
