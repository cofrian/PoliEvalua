    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.148",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.60.0",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
